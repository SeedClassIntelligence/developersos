# .env — DeveloperOS Backend
# NEVER commit this file to git — .env is in .gitignore

NODE_ENV=production
PORT=3000
# Bind to loopback; expose only through a reverse proxy (nginx)
HOST=127.0.0.1

# Reverse-proxy hops in front of the API (1 = one TLS proxy). Leave unset if
# the API is exposed directly.
# TRUST_PROXY=1

# Your frontend domain (CORS whitelist)
FRONTEND_URL=http://YOUR_VPS_IP_OR_DOMAIN

# JWT secret — REQUIRED (server refuses to start without it). Generate with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_STRING
JWT_EXPIRES_IN=8h

# PostgreSQL — REQUIRED. Two roles, deliberately separated (EF-3):
#
# MIGRATION_DATABASE_URL — schema owner. Used ONLY by `npm run db:migrate`
#   (and the test seeder). Owns every table, including the audit ledger.
#   Needs CREATEROLE to create the runtime role on first run; otherwise a DBA
#   must create the runtime LOGIN role beforehand. Never give this to the API.
MIGRATION_DATABASE_URL=postgresql://devos_owner:STRONG_RANDOM_PASSWORD_1@127.0.0.1:5432/developeros
#
# DATABASE_URL — runtime role the API connects as. Must be a different role:
#   non-superuser, no CREATEROLE/CREATEDB/REPLICATION/BYPASSRLS, owns nothing.
#   Migrations grant it DML on business tables and read-only ledger access.
#   The API refuses to start if this role could bypass audit immutability.
DATABASE_URL=postgresql://devos_app:STRONG_RANDOM_PASSWORD_2@127.0.0.1:5432/developeros
#
# Local development only: with NODE_ENV other than production and a loopback
# host, an embedded PostgreSQL (devDependency) is started if nothing listens on
# the port. Production always connects only to these URLs.
# DEVOS_EMBEDDED_PG=false   # disable the embedded engine entirely
#
# Tests NEVER use these databases: they derive "<dbname>_test" from the owner
# URL, recreate it empty on every gate run, and provision a dedicated test
# runtime role. The destructive seeder refuses any non-test database.

# Audit checkpoint signing key — REQUIRED in production. Ed25519 private key,
# base64 PKCS#8 DER. Keep it out of the database and back it up: receipts
# signed with it are the evidence that survives a database compromise.
#   node -e "console.log(require('crypto').generateKeyPairSync('ed25519').privateKey.export({type:'pkcs8',format:'der'}).toString('base64'))"
AUDIT_SIGNING_KEY=REPLACE_WITH_BASE64_PKCS8_ED25519_KEY
# After rotating, list retired public keys (base64 SPKI DER, from
# GET /api/audit/signing-key) so earlier checkpoints still verify.
# AUDIT_TRUSTED_PUBLIC_KEYS=

# Upgrade: Claude AI
# ANTHROPIC_API_KEY=sk-ant-...

# Email (invitations, password reset) — enabled only when SMTP_HOST, MAIL_FROM
# and APP_BASE_URL are set. Without it, administrators share invitation links.
# APP_BASE_URL=https://developeros.example.com
# MAIL_FROM=DeveloperOS <noreply@yourdomain.com>
# SMTP_HOST=smtp.yourdomain.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=noreply@yourdomain.com
# SMTP_PASS=your_smtp_password

# Rate limits per client address per 15 minutes (credential routes / all API).
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_API_MAX=1000
