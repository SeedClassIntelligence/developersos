# .env — DeveloperOS Backend
# NEVER commit this file to git — .env is in .gitignore

NODE_ENV=production
PORT=3000
# Bind to loopback; expose only through a reverse proxy (nginx)
HOST=127.0.0.1

# Your frontend domain (CORS whitelist)
FRONTEND_URL=http://YOUR_VPS_IP_OR_DOMAIN

# JWT secret — REQUIRED (server refuses to start without it). Generate with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_STRING
JWT_EXPIRES_IN=8h

# PostgreSQL — REQUIRED. Use a strong generated password, never "password".
# Tests NEVER use this database: they derive "<dbname>_test" from it and
# the destructive seeder refuses to run against any non-test database.
DATABASE_URL=postgresql://dbuser:STRONG_RANDOM_PASSWORD@127.0.0.1:5432/developeros

# Upgrade: Claude AI
# ANTHROPIC_API_KEY=sk-ant-...

# Upgrade: Email (password reset / invites)
# SMTP_HOST=smtp.yourdomain.com
# SMTP_PORT=587
# SMTP_USER=noreply@yourdomain.com
# SMTP_PASS=your_smtp_password
