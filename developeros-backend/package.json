{
  "name": "developeros-backend",
  "version": "1.0.0",
  "description": "DeveloperOS Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:migrate": "node db/migrate.js",
    "db:seed": "node db/seed.js",
    "test": "node tests/runner.js all",
    "test:clean-db": "node tests/runner.js clean-db",
    "test:regression": "node tests/runner.js regression",
    "test:golden": "node tests/runner.js golden",
    "test:security": "node tests/runner.js security",
    "test:ef1": "node tests/runner.js ef1",
    "test:ef2": "node tests/runner.js ef2",
    "test:golden-security": "node tests/runner.js golden-security",
    "test:ef3": "node tests/runner.js ef3",
    "test:di1": "node tests/runner.js di1",
    "test:di2": "node tests/runner.js di2",
    "check": "node scripts/check-js.js",
    "build": "npm run check",
    "test:gate": "npm run check && node tests/runner.js all",
    "test:ui": "node tests/runner.js ui",
    "test:access": "node tests/runner.js access"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "7.0.13",
    "pg": "^8.23.1",
    "uuid": "^9.0.0"
