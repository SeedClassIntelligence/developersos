# deploy/.env.production — DeveloperOS compose stack configuration.
# Copy to deploy/.env.production (ignored by version control) and fill in:
#
#   cp deploy/.env.production.example deploy/.env.production
#   node scripts/generate-secrets.js        # paste the four secret lines below
#   chmod 600 deploy/.env.production
#
# Used as:  docker compose -f deploy/compose.yaml --env-file deploy/.env.production ...
# Compose interpolates these into each service's environment. The app container
# receives only DATABASE_URL (runtime role), JWT_SECRET, AUDIT_SIGNING_KEY,
# AUDIT_TRUSTED_PUBLIC_KEYS and FRONTEND_URL, never the owner password.

# ── Images ───────────────────────────────────────────────────
# PostgreSQL 18 image for the db service (backup/restore scripts exec into it).
POSTGRES_IMAGE=postgres:18
# Base image used to build the app image, and the resulting tag.
NODE_IMAGE=node:22-bookworm-slim
DEVOS_APP_IMAGE=developeros:local

# ── Database ─────────────────────────────────────────────────
POSTGRES_DB=developeros
# Schema owner (and superuser of the bundled db cluster). Used only by the
# migrate service and by backups. Generate:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
POSTGRES_OWNER_USER=devos_owner
POSTGRES_OWNER_PASSWORD=REPLACE_WITH_RANDOM_HEX
# Unprivileged runtime role the API connects as; created by the first migrate
# run. Must differ from POSTGRES_OWNER_USER. Generate as above.
DEVOS_RUNTIME_USER=devos_app
DEVOS_RUNTIME_PASSWORD=REPLACE_WITH_RANDOM_HEX
# Set to true for ONE migrate run after changing DEVOS_RUNTIME_PASSWORD (rotation).
DEVOS_SYNC_RUNTIME_PASSWORD=false

# ── Application secrets ──────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_RANDOM_HEX
JWT_EXPIRES_IN=8h
# Ed25519 checkpoint signing key, base64 PKCS#8 DER. Back it up with the DB.
# Generate: node -e "console.log(require('crypto').generateKeyPairSync('ed25519').privateKey.export({type:'pkcs8',format:'der'}).toString('base64'))"
AUDIT_SIGNING_KEY=REPLACE_WITH_BASE64_PKCS8_ED25519_KEY
# Comma-separated base64 SPKI public keys of retired signing keys (after rotation).
AUDIT_TRUSTED_PUBLIC_KEYS=

# ── HTTP ─────────────────────────────────────────────────────
# Public origin(s) of the UI, comma-separated (CORS allow-list).
FRONTEND_URL=https://developeros.example.com
# Host interface/port the app is published on. Keep 127.0.0.1 and put a
# TLS-terminating reverse proxy in front of it.
DEVOS_HTTP_BIND=127.0.0.1
DEVOS_HTTP_PORT=3000
# Number of reverse-proxy hops in front of the app. 1 = one TLS proxy (nginx,
# Caddy, a load balancer); client IPs for rate limiting come from its
# X-Forwarded-For. Set empty ONLY if the app port is exposed directly.
TRUST_PROXY=1

# ── Email (invitations, password reset) ─────────────────────
# Any transactional SMTP provider. Email is enabled only when SMTP_HOST,
# MAIL_FROM and APP_BASE_URL are all set; without it, administrators share
# invitation links and the sign-in screen hides self-service reset
# (operators can issue a link: node scripts/password-reset-link.js <email>).
APP_BASE_URL=https://developeros.example.com
MAIL_FROM=DeveloperOS <noreply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ── Rate limits (per client address, per 15 minutes) ────────
RATE_LIMIT_API_MAX=1000
RATE_LIMIT_AUTH_MAX=10
